DATABASE_URL=postgres://cs_odds:cs_odds@localhost:5432/cs_odds
BIND_ADDR=0.0.0.0:8080
FRONTEND_ORIGIN=http://localhost:3000
RUST_LOG=cs_odds_backend=debug,tower_http=info,sqlx=warn

# Auth. Generate a secret with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-chars
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
# Must be true in production (HTTPS).
COOKIE_SECURE=false

# First admin account, created on startup only if no admin exists.
ADMIN_EMAIL=admin@cs-odds.local
ADMIN_NAME=Administrator
ADMIN_PASSWORD=change-me-please

# Attachments: S3-compatible storage (compose service "s3", RustFS).
S3_ENDPOINT=http://localhost:9000
# Address browsers use for upload/download links (differs only inside Docker).
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=cs-odds-attachments
S3_ACCESS_KEY=csodds
S3_SECRET_KEY=csodds-dev-secret

# Email notifications. Local: Mailpit catches everything at http://localhost:8025.
# Production: smtps://user:pass@smtp.example.com (TLS) or smtp://...:587?tls=required.
SMTP_URL=smtp://localhost:1025
MAIL_FROM="CS-ODDS Support <support@cs-odds.local>"
# Web app address used in email links (defaults to FRONTEND_ORIGIN).
APP_URL=http://localhost:3000
EMAIL_WORKER_INTERVAL_SECONDS=5
